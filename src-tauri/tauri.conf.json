{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cosl-operator-tauri",
  "version": "0.1.0",
  "identifier": "com.win11.cosl-operator-tauri",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run prepare:ocr-runtime && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "COSL Operator",
        "label": "main",
        "width": 1600,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/flojoy/**/*",
      "resources/models/*",
      "resources/vibration/ocr-service/*.py",
      "resources/vibration/ocr-service/*.yaml",
      "resources/vibration/ocr-service/*.txt",
      "resources/vibration/ocr-service/data/**/*.png",
      "resources/vibration/ocr-service/ocr_service/*.py",
      "resources/vibration/ocr-service/ocr_service/capture/*.py",
      "resources/vibration/ocr-service/ocr_service/ocr/*.py",
      "resources/vibration/ocr-service/ocr_service/vision/*.py",
      "resources/vibration/ocr-service/bin/**/*",
      "resources/high-temp-pressure/**/*",
      "resources/sensorless-oven/**/*",
      "resources/ocr-runtime/**/*"
    ]
  }
}
